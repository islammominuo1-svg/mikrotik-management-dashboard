PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mikrotik_manager
DB_USER=root
DB_PASSWORD=
CORS_ORIGIN=http://localhost:3000
# Maximum wait for each RouterOS REST GET request, in milliseconds (default: 15000).
MIKROTIK_GET_TIMEOUT_MS=15000
# Optional local PEM CA certificate used when verify_tls is enabled for a router.
# Relative paths are resolved from this directory.
MIKROTIK_CA_CERT=certs/mikrotik-ca.crt
